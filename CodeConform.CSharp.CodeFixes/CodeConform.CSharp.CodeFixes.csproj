<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CodeConform.CSharp.Analyzers\CodeConform.CSharp.Analyzers.csproj" />

		<!-- Roslyn workspace and code-fix APIs used by CodeFixProvider implementations. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- Run CodeConform against its own code-fix implementation. -->
		<Analyzer Include="..\CodeConform.CSharp.Analyzers\bin\$(Configuration)\netstandard2.0\CodeConform.CSharp.Analyzers.dll" />
	</ItemGroup>

</Project>
