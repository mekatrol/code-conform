<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

		<!--
		This project produces an analyzer NuGet package rather than a normal
		runtime library package. The assemblies are therefore placed under
		analyzers/dotnet/cs instead of lib/netstandard2.0.
		-->
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<DevelopmentDependency>true</DevelopmentDependency>

		<!-- NuGet package metadata -->
		<PackageId>CodeConform.CSharp</PackageId>
		<Version>0.1.0</Version>
		<Authors>Mekatrol</Authors>
		<Description>Custom C# code quality and formatting rules.</Description>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<!-- Roslyn compiler APIs used by diagnostic analyzers. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp"
						  PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!--
		Provide analyzer release tracking files required by Roslyn analyzer
		validation rules.
		-->
		<AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
		<AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
	</ItemGroup>

	<ItemGroup>
		<!--
	Package the compiler-safe analyzer assembly without exposing its physical
	bin directory as part of the project hierarchy in Solution Explorer.
	-->
		<None Include="$(OutputPath)$(AssemblyName).dll"
			  Pack="true"
			  PackagePath="analyzers/dotnet/cs"
			  Visible="false"
			  Link="Package\$(AssemblyName).dll" />

		<!--
	Package the separate code-fix assembly without exposing its physical output
	directory as part of this project's hierarchy.
	-->
		<None Include="..\CodeConform.CSharp.CodeFixes\bin\$(Configuration)\netstandard2.0\CodeConform.CSharp.CodeFixes.dll"
			  Pack="true"
			  PackagePath="analyzers/dotnet/cs"
			  Visible="false"
			  Link="Package\CodeConform.CSharp.CodeFixes.dll" />
	</ItemGroup>

	<!--
	Build the code-fix project before NuGet creates the package.

	CodeConform.CSharp.CodeFixes already references this analyzer project, so
	we cannot add a ProjectReference back to it without creating a circular
	project dependency. Invoking MSBuild here keeps the compile-time dependency
	direction correct while ensuring the DLL exists before packing.
	-->
	<Target Name="BuildCodeFixesForPack"
			BeforeTargets="GenerateNuspec"
			Condition="'$(IsPacking)' == 'true'">
		<MSBuild Projects="..\CodeConform.CSharp.CodeFixes\CodeConform.CSharp.CodeFixes.csproj"
				 Targets="Build"
				 Properties="Configuration=$(Configuration)" />
	</Target>

</Project>